[Unit]
Description=Spectr Vision — silo empty monitoring
# Ethernet camera + desktop session. Do not wait for USB video0.
After=graphical.target network-online.target
Wants=graphical.target network-online.target

[Service]
Type=simple
User=spectr
WorkingDirectory=/home/spectr/silo-alert
EnvironmentFile=-/home/spectr/silo-alert/.env
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WINIT_UNIX_BACKEND=x11

# Keep the panel awake: a blanked screen hides the operator UI.
ExecStartPre=-/usr/bin/xset -display :0 s off
ExecStartPre=-/usr/bin/xset -display :0 s noblank
ExecStartPre=-/usr/bin/xset -display :0 -dpms
# Force PTT High-Z (input, no pull) on GPIO23 only — never touch GPIO17.
ExecStartPre=-/usr/bin/pinctrl set 23 ip

ExecStart=/home/spectr/silo-alert/target/release/silo-alert

# Watchdog: any exit, crash or clean, brings it straight back.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

StandardOutput=append:/home/spectr/silo-alert/data/service.log
StandardError=append:/home/spectr/silo-alert/data/service.log

[Install]
WantedBy=graphical.target
