[Unit]
Description=Industrial Smart System — silo empty monitoring
# The plant loop does not need the desktop. X11 is only the operator window.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spectr
WorkingDirectory=/home/spectr/silo-alert
EnvironmentFile=-/home/spectr/silo-alert/.env
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WINIT_UNIX_BACKEND=x11

# Keep the panel awake when a desktop exists. Failure is fine headless.
ExecStartPre=-/usr/bin/xset -display :0 s off
ExecStartPre=-/usr/bin/xset -display :0 s noblank
ExecStartPre=-/usr/bin/xset -display :0 -dpms
# Force PTT High-Z (input, no pull) on GPIO23 only — never touch GPIO17.
ExecStartPre=-/usr/bin/pinctrl set 23 ip

ExecStart=/home/spectr/silo-alert/target/release/silo-alert

# Watchdog: any exit, crash or clean, brings it straight back.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

# Watchdog: the plant loop must ping every few seconds. A hung loop stops
# pinging, systemd kills the process, and Restart= brings it back.
WatchdogSec=45
NotifyAccess=main

# Crash lines stay in the journal, which rotates. The plant log is the
# compact rows in Supabase, deleted after 30 days. Do not grow a file on the SD card.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
